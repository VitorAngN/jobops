generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Neon: DATABASE_URL é a conexão com pooler (uso normal da API);
  // DATABASE_URL_UNPOOLED é a conexão direta, usada pelo Prisma Migrate.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ApplicationArea {
  BACKEND
  DEVOPS
  CLOUD
  FULLSTACK
  FRONTEND
  DATA
  SECURITY
  SUPPORT
  OTHER
}

enum ApplicationLevel {
  INTERNSHIP
  TRAINEE
  JUNIOR
  MID
  SENIOR
  UNKNOWN
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum ContractType {
  INTERNSHIP
  CLT
  PJ
  TEMPORARY
  OTHER
  UNKNOWN
}

enum SourcePlatform {
  LINKEDIN
  GUPY
  COMPANY_SITE
  INDEED
  GLASSDOOR
  GREENHOUSE
  LEVER
  ASHBY
  REFERRAL
  OTHER
}

enum ApplicationStatus {
  SAVED
  APPLIED
  RECRUITER_CONTACTED
  IN_REVIEW
  TEST_SENT
  HR_INTERVIEW
  TECH_INTERVIEW
  WAITING_RESPONSE
  REJECTED
  GHOSTED
  OFFER
  ARCHIVED
}

enum ResumeLanguage {
  PT_BR
  EN
  ES
}

enum ResumeFocus {
  BACKEND
  DEVOPS
  CLOUD
  FULLSTACK
  SUPPORT
  GENERAL
}

enum DiscoverySource {
  GUPY
  GREENHOUSE
  LEVER
  ASHBY
  REMOTIVE
}

enum DiscoveredStatus {
  NEW
  APPROVED
  DISCARDED
}

enum InteractionType {
  MESSAGE
  EMAIL
  INTERVIEW
  TEST
  FEEDBACK
  NOTE
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  passwordHash   String?
  applications   JobApplication[]
  resumeVersions ResumeVersion[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Company {
  id           String           @id @default(cuid())
  name         String           @unique
  website      String?
  sector       String?
  location     String?
  notes        String?
  applications JobApplication[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ResumeVersion {
  id           String           @id @default(cuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  language     ResumeLanguage   @default(PT_BR)
  focus        ResumeFocus      @default(GENERAL)
  fileUrl      String?
  notes        String?
  /// Texto do currículo (colado), usado para comparar com as vagas
  content      String?
  applications JobApplication[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model JobApplication {
  id              String            @id @default(cuid())
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resumeVersionId String?
  resumeVersion   ResumeVersion?    @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  title           String
  area            ApplicationArea   @default(BACKEND)
  level           ApplicationLevel  @default(INTERNSHIP)
  workMode        WorkMode          @default(REMOTE)
  location        String?
  contractType    ContractType      @default(UNKNOWN)
  sourcePlatform  SourcePlatform    @default(LINKEDIN)
  jobUrl          String?
  description     String?
  status          ApplicationStatus @default(SAVED)
  fitScore        Int?
  foundAt         DateTime?
  appliedAt       DateTime?
  lastResponseAt  DateTime?
  nextAction      String?
  followUpAt      DateTime?
  notes           String?
  interactions    Interaction[]
  reminders       Reminder[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([area])
  @@index([sourcePlatform])
  @@index([appliedAt])
}

model Interaction {
  id            String          @id @default(cuid())
  applicationId String
  application   JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          InteractionType @default(NOTE)
  contactName   String?
  contactRole   String?
  contactUrl    String?
  happenedAt    DateTime        @default(now())
  description   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Reminder {
  id            String         @id @default(cuid())
  applicationId String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  dueAt         DateTime
  done          Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}


// ---------- Busca automática de vagas ----------

/// Filtros de uma busca salva (ex.: "Estágio back-end"). A busca diária roda todos os ativos.
model SearchProfile {
  id               String            @id @default(cuid())
  name             String
  active           Boolean           @default(true)
  /// Área das candidaturas criadas a partir desta busca
  area             ApplicationArea   @default(BACKEND)
  /// Termos pesquisados nas fontes (ex.: "estágio desenvolvimento", "estágio back-end")
  terms            String[]
  /// Palavras que aumentam a nota (ex.: node, typescript, go, backend)
  keywords         String[]
  /// Palavras que eliminam a vaga (ex.: sênior, pleno, vendas)
  excludeWords     String[]
  /// Cidades/estados aceitos para vaga presencial ou híbrida (ex.: Londrina, Curitiba, PR)
  locations        String[]
  acceptRemote     Boolean           @default(true)
  sources          DiscoverySource[]
  minScore         Int               @default(40)
  companies        WatchedCompany[]
  jobs             DiscoveredJob[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

/// Empresa acompanhada direto no sistema de vagas dela (Greenhouse, Lever ou Ashby).
model WatchedCompany {
  id        String          @id @default(cuid())
  profileId String
  profile   SearchProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  source    DiscoverySource
  /// Identificador da empresa no sistema (ex.: "nubank" em boards.greenhouse.io/nubank)
  slug      String
  name      String
  createdAt DateTime        @default(now())

  @@unique([profileId, source, slug])
}

/// Vaga encontrada automaticamente, esperando triagem.
model DiscoveredJob {
  id            String           @id @default(cuid())
  source        DiscoverySource
  externalId    String
  profileId     String?
  profile       SearchProfile?   @relation(fields: [profileId], references: [id], onDelete: SetNull)
  title         String
  company       String
  location      String?
  workMode      WorkMode         @default(UNKNOWN)
  level         ApplicationLevel @default(UNKNOWN)
  url           String
  description   String?
  publishedAt   DateTime?
  score         Int              @default(0)
  scoreReasons  String[]
  status        DiscoveredStatus @default(NEW)
  applicationId String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([source, externalId])
  @@index([status, score])
}

/// Registro de cada execução da busca (para mostrar "última busca" e erros por fonte).
model DiscoveryRun {
  id         String    @id @default(cuid())
  trigger    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  found      Int       @default(0)
  created    Int       @default(0)
  errors     String[]
}
